{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; script-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; form-action 'self'"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/pushkar-fair",
      "destination": "/index.html"
    },
    {
      "source": "/pushkar-fair-dates-2026",
      "destination": "/programme.html"
    },
    {
      "source": "/photography",
      "destination": "/photography.html"
    },
    {
      "source": "/local-people-and-communities",
      "destination": "/culture-and-communities.html"
    },
    {
      "source": "/pushkar-tours",
      "destination": "/luxury-tours.html"
    },
    {
      "source": "/pushkar-fair-photo-gallery",
      "destination": "/gallery.html"
    },
    {
      "source": "/contact-us",
      "destination": "/contact.html"
    },
    {
      "source": "/glimpses-of-india",
      "destination": "/glimpses-of-india.html"
    },
    {
      "source": "/haveli-diwali-and-pushkar-fair",
      "destination": "/haveli-diwali.html"
    },
    {
      "source": "/pushkar-fair-and-dev-diwali",
      "destination": "/pushkar-dev-diwali.html"
    },
    {
      "source": "/enquiry",
      "destination": "/enquiry.html"
    }
  ],
  "redirects": [
    {
      "source": "/",
      "destination": "/pushkar-fair",
      "permanent": false
    }
  ]
}
