{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; script-src 'self' https://www.google.com/recaptcha/ https://www.gstatic.com/recaptcha/; frame-src https://www.google.com/recaptcha/ https://recaptcha.google.com/recaptcha/; style-src 'self' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self' https://www.google.com/recaptcha/; form-action 'self'"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/pushkar-fair",
      "destination": "/index.html"
    },
    {
      "source": "/pushkar-fair-dates-2026",
      "destination": "/programme.html"
    },
    {
      "source": "/programme",
      "destination": "/programme.html"
    },
    {
      "source": "/photography",
      "destination": "/photography.html"
    },
    {
      "source": "/photography-tips",
      "destination": "/photography.html"
    },
    {
      "source": "/local-people-and-communities",
      "destination": "/culture-and-communities.html"
    },
    {
      "source": "/culture-and-communities",
      "destination": "/culture-and-communities.html"
    },
    {
      "source": "/pushkar-tours",
      "destination": "/luxury-tours.html"
    },
    {
      "source": "/luxury-tours",
      "destination": "/luxury-tours.html"
    },
    {
      "source": "/pushkar-fair-photo-gallery",
      "destination": "/gallery.html"
    },
    {
      "source": "/contact-us",
      "destination": "/contact.html"
    },
    {
      "source": "/glimpses-of-india",
      "destination": "/glimpses-of-india.html"
    },
    {
      "source": "/tours/glimpses-of-india",
      "destination": "/glimpses-of-india.html"
    },
    {
      "source": "/tours/glimpses-of-india/",
      "destination": "/glimpses-of-india.html"
    },
    {
      "source": "/haveli-diwali-and-pushkar-fair",
      "destination": "/haveli-diwali.html"
    },
    {
      "source": "/tours/haveli-diwali-pushkar-fair",
      "destination": "/haveli-diwali.html"
    },
    {
      "source": "/tours/haveli-diwali-pushkar-fair/",
      "destination": "/haveli-diwali.html"
    },
    {
      "source": "/pushkar-fair-and-dev-diwali",
      "destination": "/pushkar-dev-diwali.html"
    },
    {
      "source": "/tours/pushkar-fair-and-dev-diwali",
      "destination": "/pushkar-dev-diwali.html"
    },
    {
      "source": "/tours/pushkar-fair-and-dev-diwali/",
      "destination": "/pushkar-dev-diwali.html"
    }
  ],
  "redirects": [
    {
      "source": "/enquiry",
      "destination": "/contact-us",
      "permanent": false
    },
    {
      "source": "/",
      "destination": "/pushkar-fair",
      "permanent": false
    }
  ]
}
